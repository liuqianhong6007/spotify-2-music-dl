# Spotify Developer Dashboard 中创建的应用 Client ID
SPOTIFY_CLIENT_ID=

# 必须与 Spotify 应用后台配置的 Redirect URI 完全一致
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8888/callback

# OAuth token 缓存
SPOTIFY_TOKEN_FILE=.spotify-token.json

# 可选：Exportify 导出的 liked songs CSV。
# 设置后不会调用 Spotify Web API 或 OAuth，适合 App 所有者账号没有 Premium 的情况。
SPOTIFY_EXPORT_FILE=

# go-music-dl / go-music-api 服务根地址
MUSICDL_BASE_URL=http://192.168.1.10:8080

# auto / web / v1 / compat
# web: 原生 go-music-dl Web 模式，支持 --save-on-nas
# v1: go-music-api 的 /api/v1/* 接口
# compat: go-music-api 的 /music/* 兼容接口
MUSICDL_MODE=auto

# 原生 go-music-dl 默认挂载路径；未使用 --base-path 时通常是 music
MUSICDL_PREFIX=music

# 留空表示使用 go-music-dl 默认音乐源
MUSICDL_SOURCES=

# 本地下载目录，使用 --save-on-nas 时忽略
MUSICDL_OUTPUT_DIR=downloads

# 断点状态文件
MUSICDL_STATE_FILE=.musicdl-state.json

# 请求间隔、超时和重试
# 时间格式支持 Go duration（500ms、2s）或纯数字秒数
MUSICDL_DELAY=500ms
MUSICDL_TIMEOUT=45s
MUSICDL_RETRIES=3

# 匹配阈值，越高越保守
MUSICDL_MIN_SCORE=70

# 可选的反向代理鉴权请求头，多个用 || 分隔
# MUSICDL_HEADERS=Cookie=session=xxx; other=yyy||X-Api-Key=zzz
